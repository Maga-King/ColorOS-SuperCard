# 仅跟踪构建与源码所需文件；排除设备日志、备份和临时诊断。
*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY.md
!/build.gradle.kts
!/settings.gradle.kts
!/gradlew
!/gradlew.bat
!/gradle/
!/gradle/**
!/app/
!/app/build.gradle.kts
!/app/src/
!/app/src/**
!/root-backend/
!/root-backend/**
!/tools/
!/tools/*.java
!/tools/*.py
!/tools/unified-prototype/
!/tools/unified-prototype/build.py
!/tools/unified-prototype/*.java
!/tools/asset-patcher-libs/
!/tools/asset-patcher-libs/**
!/vendor/
!/vendor/**
!/ci/
!/ci/**
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/docs/
!/docs/*.md
**/*.keystore
**/*.jks
**/local.properties
**/__pycache__/
**/*.pyc
